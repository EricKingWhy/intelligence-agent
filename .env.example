# 复制为 .env 并填入真实值。provider 可选：deepseek / qwen

MODEL_PROVIDER=deepseek
MODEL_API_KEY=sk-xxx

# 以下可选：不填则使用厂商预设（deepseek-chat / qwen-plus 及对应 base_url）
# MODEL_NAME=deepseek-chat
# MODEL_BASE_URL=https://api.deepseek.com

# MODEL_NAME=qwen-plus
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

TEMPERATURE=0.2
# Phase 6 身份：未配置时使用 local；配置后验证 Bearer JWT（HS256）。
# JWT_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=INFO

# Phase 5：Context 预算（应按实际模型窗口配置）
MAX_CONTEXT_TOKENS=200000
AUTO_COMPACT_THRESHOLD=0.70
HARD_GUARD_THRESHOLD=0.85
ARTIFACT_OVERFLOW_CHARS=2000

# 七牛云 Kodo S3：五项全留空时 Web 不启用 Artifact；启用时必须全部填写。
# bucket 填 S3 空间名，endpoint/region 与空间所在区域一致。
# 安装 SDK：uv sync --inexact --extra artifact
ARTIFACT_STORE_ENDPOINT=
ARTIFACT_STORE_BUCKET=
ARTIFACT_STORE_ACCESS_KEY=
ARTIFACT_STORE_SECRET_KEY=
ARTIFACT_STORE_REGION=

# 腾讯 Coding Plan（无默认模型，MODEL_NAME 必填）
# MODEL_PROVIDER=tencent
# MODEL_NAME=claude-sonnet-4-5
